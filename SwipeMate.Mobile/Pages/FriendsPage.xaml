<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SwipeMate.Mobile.Pages.FriendsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF7FC" Offset="0.0" />
            <GradientStop Color="#F7F2FF" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,28" Spacing="18" MaximumWidthRequest="760" HorizontalOptions="Center">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Button Text="Назад" BackgroundColor="Transparent" TextColor="#111827" Padding="0" MinimumWidthRequest="64" Clicked="OnBackClicked" />
                <Label Grid.Column="1" Text="Приятели" FontSize="24" FontAttributes="Bold" TextColor="#111827" VerticalTextAlignment="Center" />
            </Grid>

            <Frame Padding="18" CornerRadius="18" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Добави нов приятел" FontSize="22" FontAttributes="Bold" TextColor="#111827" />
                    <Entry x:Name="FriendUserNameEntry"
                           Placeholder="Търси по потребителско име или имейл"
                           TextColor="#111827"
                           PlaceholderColor="#9CA3AF"
                           BackgroundColor="#F9FAFB"
                           ClearButtonVisibility="WhileEditing"
                           TextChanged="OnFriendSearchChanged" />
                    <CollectionView x:Name="SuggestionsCollectionView" SelectionMode="None" IsVisible="False" MaximumHeightRequest="260">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Margin="0,0,0,10" Padding="12" CornerRadius="14" BackgroundColor="#F9FAFB" HasShadow="False" BorderColor="#E5E7EB">
                                    <VerticalStackLayout Spacing="12">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 22" BackgroundColor="#FCE7F3">
                                                <Label Text="{Binding AvatarInitials}" TextColor="#DB2777" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding UserName}" FontAttributes="Bold" FontSize="17" TextColor="#111827" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Email}" FontSize="13" TextColor="#6B7280" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <Button Text="Добави" BackgroundColor="#C026D3" TextColor="White" CornerRadius="14" Clicked="OnSuggestionAddClicked" />
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label x:Name="NoSuggestionsLabel" Text="Започни да пишеш, за да откриеш съществуващи потребители." TextColor="#6B7280" FontSize="14" />
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="18" CornerRadius="18" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False">
                <VerticalStackLayout Spacing="14">
                    <Label x:Name="RequestsHeaderLabel" Text="Покани" FontSize="22" FontAttributes="Bold" TextColor="#111827" />
                    <CollectionView x:Name="RequestsCollectionView" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Margin="0,0,0,10" Padding="12" CornerRadius="14" BackgroundColor="#F9FAFB" HasShadow="False" BorderColor="#E5E7EB">
                                    <VerticalStackLayout Spacing="12">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 22" BackgroundColor="#FCE7F3">
                                                <Label Text="{Binding AvatarInitials}" TextColor="#DB2777" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="{Binding UserName}" FontAttributes="Bold" FontSize="17" TextColor="#111827" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding DisplayName}" FontSize="13" TextColor="#6B7280" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Button Text="Приеми" BackgroundColor="#10B981" TextColor="White" CornerRadius="14" Clicked="OnAcceptClicked" />
                                            <Button Grid.Column="1" Text="Откажи" BackgroundColor="#EF4444" TextColor="White" CornerRadius="14" Clicked="OnRejectClicked" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label x:Name="NoRequestsLabel" Text="Няма чакащи покани за приятелство." IsVisible="False" TextColor="#6B7280" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="18" CornerRadius="18" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False">
                <VerticalStackLayout Spacing="14">
                    <Label x:Name="FriendsHeaderLabel" Text="Моите приятели" FontSize="22" FontAttributes="Bold" TextColor="#111827" />
                    <CollectionView x:Name="FriendsCollectionView" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Margin="0,0,0,10" Padding="12" CornerRadius="14" BackgroundColor="#F9FAFB" HasShadow="False" BorderColor="#E5E7EB">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 22" BackgroundColor="#EDE9FE">
                                            <Label Text="{Binding AvatarInitials}" TextColor="#7C3AED" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding UserName}" FontAttributes="Bold" FontSize="17" TextColor="#111827" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding DisplayName}" FontSize="13" TextColor="#6B7280" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label x:Name="NoFriendsLabel" Text="Все още нямаш приятели. Добави приятел чрез търсене на съществуващ потребител." IsVisible="False" TextColor="#6B7280" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SwipeMate.Mobile.Pages.AdminPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF7FC" Offset="0.0" />
            <GradientStop Color="#F7F2FF" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="24,24,24,28" Spacing="18" MaximumWidthRequest="960" HorizontalOptions="Center">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Text="Назад" BackgroundColor="Transparent" TextColor="#111827" Clicked="OnBackClicked" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="Админ панел" FontSize="24" FontAttributes="Bold" TextColor="#111827" />
                    <Label Text="Управление на потребители, каталог и резервно копие на данните" FontSize="13" TextColor="#6B7280" />
                </VerticalStackLayout>
                <Button Grid.Column="2" Text="Обнови" BackgroundColor="White" BorderColor="#E5E7EB" BorderWidth="1" TextColor="#111827" Clicked="OnRefreshClicked" />
            </Grid>

            <ActivityIndicator x:Name="LoadingIndicator" IsVisible="False" IsRunning="False" Color="#C026D3" />

            <Label x:Name="AccessDeniedLabel" Text="Тази страница е достъпна само за администратор." IsVisible="False" TextColor="#B91C1C" HorizontalTextAlignment="Center" />

            <VerticalStackLayout x:Name="AdminContent" Spacing="18">
                <Frame Padding="18" CornerRadius="14" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Потребители" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                            <Label x:Name="UsersCountLabel" Grid.Column="1" FontSize="13" TextColor="#6B7280" VerticalTextAlignment="Center" />
                        </Grid>
                        <CollectionView x:Name="UsersCollectionView" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame Margin="0,0,0,10" Padding="14" CornerRadius="12" BackgroundColor="#F9FAFB" BorderColor="#E5E7EB" HasShadow="False">
                                        <VerticalStackLayout Spacing="12">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                <Border WidthRequest="52" HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 26" BackgroundColor="#FCE7F3" VerticalOptions="Start">
                                                    <Label Text="{Binding AvatarInitials}" TextColor="#DB2777" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                                    <Label Text="{Binding UserName}" FontSize="17" FontAttributes="Bold" TextColor="#111827" LineBreakMode="TailTruncation" MaxLines="1" />
                                                    <Label Text="{Binding DisplayName}" FontSize="13" TextColor="#374151" LineBreakMode="TailTruncation" MaxLines="1" />
                                                    <Label Text="{Binding Email}" FontSize="12" TextColor="#6B7280" LineBreakMode="TailTruncation" MaxLines="1" />
                                                    <Label Text="{Binding RoleText, StringFormat='Роли: {0}'}" FontSize="12" TextColor="#6B7280" LineBreakMode="TailTruncation" MaxLines="1" />
                                                    <Label Text="{Binding StatsText}" FontSize="12" TextColor="#6B7280" LineBreakMode="WordWrap" MaxLines="2" />
                                                    <Label Text="{Binding StatusText}" FontSize="12" FontAttributes="Bold" TextColor="#C026D3" />
                                                    <Label Text="{Binding BioPreview}" FontSize="12" TextColor="#374151" LineBreakMode="TailTruncation" MaxLines="2" />
                                                    <Label Text="{Binding BlockedReason}" FontSize="12" TextColor="#B91C1C" LineBreakMode="TailTruncation" MaxLines="2" />
                                                </VerticalStackLayout>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                <Button Text="Детайли" HeightRequest="46" BackgroundColor="White" BorderColor="#E5E7EB" BorderWidth="1" TextColor="#111827" Clicked="OnUserDetailsClicked" />
                                                <Button Grid.Column="1" Text="{Binding ActionText}" HeightRequest="46" BackgroundColor="#C026D3" TextColor="White" Clicked="OnBlockToggleClicked" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <Frame Padding="18" CornerRadius="14" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Каталог" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                            <Label x:Name="CatalogCountLabel" Grid.Column="1" FontSize="13" TextColor="#6B7280" VerticalTextAlignment="Center" />
                        </Grid>
                        <CollectionView x:Name="CatalogCollectionView" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame Margin="0,0,0,10" Padding="14" CornerRadius="12" BackgroundColor="#F9FAFB" BorderColor="#E5E7EB" HasShadow="False">
                                        <VerticalStackLayout Spacing="12">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="#111827" LineBreakMode="TailTruncation" MaxLines="1" />
                                                <Label Text="{Binding Category}" FontSize="12" TextColor="#6B7280" />
                                                <Label Text="{Binding Summary}" FontSize="12" TextColor="#374151" LineBreakMode="TailTruncation" MaxLines="2" />
                                                <Label Text="{Binding StatusText}" FontSize="12" FontAttributes="Bold" TextColor="#C026D3" />
                                            </VerticalStackLayout>
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                <Button Text="Детайли" HeightRequest="46" BackgroundColor="White" BorderColor="#E5E7EB" BorderWidth="1" TextColor="#111827" Clicked="OnCatalogDetailsClicked" />
                                                <Button Grid.Column="1" Text="{Binding ActionText}" HeightRequest="46" BackgroundColor="#111827" TextColor="White" Clicked="OnCatalogToggleClicked" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                <Frame Padding="18" CornerRadius="14" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Backup/export" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                        <Label Text="Създава JSON export без паролни хешове, подходящ за демонстрация и проверка." FontSize="13" TextColor="#6B7280" />
                        <Button Text="Създай backup файл" BackgroundColor="#C026D3" TextColor="White" HeightRequest="48" CornerRadius="10" Clicked="OnBackupClicked" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>


<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SwipeMate.Mobile.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title=""
    Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FDF2F8" Offset="0.0" />
            <GradientStop Color="#F5F3FF" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <Grid Padding="24" RowDefinitions="*" VerticalOptions="Center">
            <Frame
                Padding="24"
                CornerRadius="24"
                BackgroundColor="White"
                HasShadow="True"
                MaximumWidthRequest="420"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <VerticalStackLayout Spacing="18">

                    <!-- Logo circle -->
                    <Frame
                        WidthRequest="72"
                        HeightRequest="72"
                        CornerRadius="36"
                        Padding="0"
                        HorizontalOptions="Center"
                        HasShadow="False">
                        <Frame.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#EC4899" Offset="0.0" />
                                <GradientStop Color="#A855F7" Offset="1.0" />
                            </LinearGradientBrush>
                        </Frame.Background>

                        <Grid WidthRequest="72" HeightRequest="72">
                            <Border
                                WidthRequest="28"
                                HeightRequest="40"
                                StrokeShape="RoundRectangle 6"
                                BackgroundColor="White"
                                Opacity="0.4"
                                Rotation="-10"
                                TranslationX="8"
                                TranslationY="10" />
                            <Border
                                WidthRequest="28"
                                HeightRequest="40"
                                StrokeShape="RoundRectangle 6"
                                BackgroundColor="White"
                                Opacity="0.7"
                                Rotation="-5"
                                TranslationX="6"
                                TranslationY="12" />
                            <Border
                                WidthRequest="28"
                                HeightRequest="40"
                                StrokeShape="RoundRectangle 6"
                                BackgroundColor="White"
                                TranslationX="4"
                                TranslationY="14" />

                            <Path
                                Stroke="White"
                                StrokeThickness="2"
                                StrokeLineCap="Round"
                                StrokeLineJoin="Round"
                                Data="M46,36 L58,36 M52,30 L58,36 L52,42" />
                        </Grid>
                    </Frame>

                    <!-- Title -->
                    <Label
                        Text="SwipeMate"
                        FontSize="30"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="#B84CF3" />

                    <Label
                        Text="Make decisions together"
                        FontSize="14"
                        HorizontalTextAlignment="Center"
                        TextColor="#6B7280" />

                    <!-- Username -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Username" FontSize="12" TextColor="#111827" />
                        <Border
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#F3F4F6"
                            Padding="14,10">
                            <Entry
                                x:Name="UsernameEntry"
                                Placeholder="Enter your username"
                                BackgroundColor="Transparent"
                                TextColor="#111827"
                                PlaceholderColor="#9CA3AF"
                                ReturnType="Next" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password" FontSize="12" TextColor="#111827" />
                        <Border
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="#F3F4F6"
                            Padding="14,10">
                            <Entry
                                x:Name="PasswordEntry"
                                Placeholder="Enter your password"
                                IsPassword="True"
                                BackgroundColor="Transparent"
                                TextColor="#111827"
                                PlaceholderColor="#9CA3AF"
                                ReturnType="Done" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Login button -->
                    <Button
                        Text="Log In"
                        HeightRequest="48"
                        CornerRadius="14"
                        TextColor="White"
                        FontAttributes="Bold"
                        Clicked="OnLoginClicked">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#EC4899" Offset="0.0" />
                                <GradientStop Color="#A855F7" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <Button
                        Text="Don't have an account? Sign up"
                        BackgroundColor="Transparent"
                        TextColor="#7C3AED"
                        FontSize="12"
                        Clicked="OnGoRegisterClicked" />

                </VerticalStackLayout>
            </Frame>
        </Grid>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SwipeMate.Mobile.Pages.CreateSessionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF7FC" Offset="0.0" />
            <GradientStop Color="#F7F2FF" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="16,22,16,28" Spacing="18" MaximumWidthRequest="760" HorizontalOptions="Center">
            <Grid ColumnDefinitions="Auto,*">
                <Button Text="Назад" BackgroundColor="White" TextColor="#111827" CornerRadius="18" Clicked="OnBackClicked" />
                <Label x:Name="PageTitleLabel" Grid.Column="1" Text="Създай сесия за съвпадение" FontSize="22" FontAttributes="Bold" TextColor="#111827" VerticalTextAlignment="Center" />
            </Grid>

            <Frame Padding="20" CornerRadius="16" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border WidthRequest="58" HeightRequest="58" StrokeThickness="0" StrokeShape="RoundRectangle 29">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop x:Name="CategoryGradientStart" Color="#0EA5E9" Offset="0" />
                                <GradientStop x:Name="CategoryGradientEnd" Color="#A855F7" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Path x:Name="MovieCategoryIconPath" WidthRequest="28" HeightRequest="28" Aspect="Uniform" Stroke="White" StrokeThickness="3" StrokeLineCap="Round" StrokeLineJoin="Round"
                                  Data="M4,4 L24,4 L24,24 L4,24 Z M10,4 L10,24 M18,4 L18,24 M4,10 L24,10 M4,18 L24,18" />
                            <Path x:Name="RestaurantCategoryIconPath" IsVisible="False" WidthRequest="28" HeightRequest="28" Aspect="Uniform" Stroke="White" StrokeThickness="3" StrokeLineCap="Round" StrokeLineJoin="Round"
                                  Data="M9,4 L9,24 M5,4 L5,11 M13,4 L13,11 M20,4 C16,9 16,16 20,20 L20,24 M8,16 L22,4" />
                            <Path x:Name="RecipeCategoryIconPath" IsVisible="False" WidthRequest="28" HeightRequest="28" Aspect="Uniform" Stroke="White" StrokeThickness="3" StrokeLineCap="Round" StrokeLineJoin="Round"
                                  Data="M8,14 C3,12 5,5 11,6 C13,0 19,0 21,6 C27,5 29,12 24,14 L24,24 L8,24 Z M10,20 L22,20" />
                            <Path x:Name="BoardGameCategoryIconPath" IsVisible="False" WidthRequest="28" HeightRequest="28" Aspect="Uniform" Stroke="White" StrokeThickness="3" StrokeLineCap="Round" StrokeLineJoin="Round"
                                  Data="M8,10 L18,4 L24,14 L14,20 Z M6,16 L16,10 L22,20 L12,26 Z" />
                        </Grid>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label x:Name="CategoryTitleLabel" Text="Филми и сериали" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                        <Label x:Name="CategorySubtitleLabel" Text="Избери приятели за общото решение" FontSize="13" TextColor="#6B7280" />
                    </VerticalStackLayout>
                </Grid>
            </Frame>

            <Frame x:Name="FriendsCard" Padding="20" CornerRadius="16" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False">
                <VerticalStackLayout Spacing="14">
                    <Label x:Name="SelectedFriendsLabel" Text="Избрани приятели (0)" FontSize="18" FontAttributes="Bold" TextColor="#111827" />
                    <CollectionView x:Name="FriendsCollectionView" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="6,8">
                                    <CheckBox IsChecked="False" CheckedChanged="OnFriendCheckedChanged" />
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border WidthRequest="42" HeightRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 21" BackgroundColor="#FCE7F3">
                                            <Label Text="{Binding AvatarInitials}" TextColor="#DB2777" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding UserName}" FontAttributes="Bold" FontSize="15" TextColor="#111827" />
                                            <Label Text="{Binding DisplayName}" FontSize="12" TextColor="#6B7280" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label x:Name="NoFriendsHintLabel" Text="Няма налични приятели. Добави приятели от екрана „Приятели“, за да започнеш групова сесия." TextColor="#6B7280" FontSize="12" HorizontalTextAlignment="Center" IsVisible="False" />
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="20" CornerRadius="16" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Филтри" FontSize="18" FontAttributes="Bold" TextColor="#111827" />

                    <VerticalStackLayout x:Name="MovieFiltersLayout" Spacing="14">
                        <Label Text="Жанрове" FontAttributes="Bold" TextColor="#111827" />
                        <FlexLayout x:Name="MovieGenresFlexLayout" Wrap="Wrap" Direction="Row" />
                        <Label x:Name="MovieMinRatingLabel" Text="Минимална оценка: 0.0+" TextColor="#111827" />
                        <Slider x:Name="MovieMinRatingSlider" Minimum="0" Maximum="10" ValueChanged="OnMovieRatingValueChanged" DragCompleted="OnMovieRatingChanged" />
                        <Label x:Name="MovieYearLabel" Text="Година на издаване: 1990 - 2024" TextColor="#111827" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout>
                                <Label Text="От" FontSize="12" TextColor="#6B7280" />
                                <Slider x:Name="MovieYearFromSlider" ValueChanged="OnMovieYearValueChanged" DragCompleted="OnMovieYearChanged" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="До" FontSize="12" TextColor="#6B7280" />
                                <Slider x:Name="MovieYearToSlider" ValueChanged="OnMovieYearValueChanged" DragCompleted="OnMovieYearChanged" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="RestaurantFiltersLayout" Spacing="14" IsVisible="False">
                        <Label Text="Град" FontAttributes="Bold" TextColor="#111827" />
                        <Picker x:Name="RestaurantCityPicker" SelectedIndexChanged="OnRestaurantCityChanged" TextColor="#111827" TitleColor="#6B7280" BackgroundColor="#F9FAFB" />
                        <Label Text="Квартал" FontAttributes="Bold" TextColor="#111827" />
                        <Picker x:Name="RestaurantDistrictPicker" TextColor="#111827" TitleColor="#6B7280" BackgroundColor="#F9FAFB" />
                        <Label Text="Кухня" FontAttributes="Bold" TextColor="#111827" />
                        <Picker x:Name="RestaurantCuisinePicker" TextColor="#111827" TitleColor="#6B7280" BackgroundColor="#F9FAFB" />
                        <Label x:Name="RestaurantMinRatingLabel" Text="Минимална оценка: 0.0+" TextColor="#111827" />
                        <Slider x:Name="RestaurantMinRatingSlider" Minimum="0" Maximum="10" ValueChanged="OnRestaurantRatingValueChanged" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="RecipeFiltersLayout" Spacing="14" IsVisible="False">
                        <Label Text="Кухня" FontAttributes="Bold" TextColor="#111827" />
                        <FlexLayout x:Name="RecipeCuisinesFlexLayout" Wrap="Wrap" Direction="Row" />
                        <Label Text="Тип храна" FontAttributes="Bold" TextColor="#111827" />
                        <Picker x:Name="RecipeFoodTypePicker" TextColor="#111827" TitleColor="#6B7280" BackgroundColor="#F9FAFB" />
                        <Label Text="Съставки" FontAttributes="Bold" TextColor="#111827" />
                        <FlexLayout x:Name="RecipeIngredientsFlexLayout" Wrap="Wrap" Direction="Row" />
                        <Label x:Name="RecipeComplexityLabel" Text="Максимална сложност: 5" TextColor="#111827" />
                        <Slider x:Name="RecipeComplexitySlider" Minimum="1" Maximum="5" ValueChanged="OnRecipeComplexityValueChanged" />
                        <Label x:Name="RecipeMinRatingLabel" Text="Минимална оценка: 0.0+" TextColor="#111827" />
                        <Slider x:Name="RecipeMinRatingSlider" Minimum="0" Maximum="10" ValueChanged="OnRecipeRatingValueChanged" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="GameFiltersLayout" Spacing="14" IsVisible="False">
                        <Label Text="Тип игра" FontAttributes="Bold" TextColor="#111827" />
                        <FlexLayout x:Name="GameTypesFlexLayout" Wrap="Wrap" Direction="Row" />
                        <Label x:Name="GamePlayersLabel" Text="Играчи: 1 - 8" TextColor="#111827" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Slider x:Name="GamePlayersMinSlider" Minimum="1" Maximum="8" ValueChanged="OnGamePlayersValueChanged" />
                            <Slider x:Name="GamePlayersMaxSlider" Grid.Column="1" Minimum="1" Maximum="8" ValueChanged="OnGamePlayersValueChanged" />
                        </Grid>
                        <Label x:Name="GameDurationLabel" Text="Продължителност: 15 - 180 мин" TextColor="#111827" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Slider x:Name="GameDurationMinSlider" Minimum="15" Maximum="180" ValueChanged="OnGameDurationValueChanged" />
                            <Slider x:Name="GameDurationMaxSlider" Grid.Column="1" Minimum="15" Maximum="180" ValueChanged="OnGameDurationValueChanged" />
                        </Grid>
                        <Label x:Name="GameMinRatingLabel" Text="Минимална оценка: 0.0+" TextColor="#111827" />
                        <Slider x:Name="GameMinRatingSlider" Minimum="0" Maximum="10" ValueChanged="OnGameRatingValueChanged" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Text="Отказ" BackgroundColor="White" BorderColor="#E5E7EB" BorderWidth="1" TextColor="#111827" Clicked="OnBackClicked" />
                        <Button x:Name="ContinueButton" Grid.Column="1" Text="Изпрати покани" BackgroundColor="#C026D3" TextColor="White" Clicked="OnStartClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>




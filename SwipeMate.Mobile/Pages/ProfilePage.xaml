<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SwipeMate.Mobile.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF7FC" Offset="0.0" />
            <GradientStop Color="#F7F2FF" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="24,24,24,28" Spacing="18" MaximumWidthRequest="760" HorizontalOptions="Center">
            <Grid ColumnDefinitions="Auto,*">
                <Button Text="Назад" BackgroundColor="Transparent" TextColor="#111827" Clicked="OnBackClicked" />
                <Label Grid.Column="1" Text="Моят профил" FontSize="22" FontAttributes="Bold" TextColor="#111827" VerticalTextAlignment="Center" />
            </Grid>

            <Frame Padding="26" CornerRadius="16" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Border WidthRequest="88" HeightRequest="88" StrokeShape="RoundRectangle 44" StrokeThickness="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#EC4899" Offset="0" />
                                <GradientStop Color="#7C3AED" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Image x:Name="ProfileImage" Aspect="AspectFill" IsVisible="False" />
                            <Label x:Name="AvatarLabel" Text="SM" TextColor="White" FontSize="28" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Grid>
                    </Border>
                    <Label x:Name="UserNameLabel" Text="username" FontSize="22" FontAttributes="Bold" TextColor="#111827" HorizontalTextAlignment="Center" />
                    <Border x:Name="AdminRoleBadge" Padding="10,4" BackgroundColor="#FEF3C7" Stroke="#F59E0B" StrokeShape="RoundRectangle 999" IsVisible="False" HorizontalOptions="Center">
                        <Label Text="Администратор" FontSize="12" FontAttributes="Bold" TextColor="#92400E" />
                    </Border>
                    <Label x:Name="EmailLabel" Text="email" FontSize="14" TextColor="#6B7280" HorizontalTextAlignment="Center" />
                    <Label x:Name="BioPreviewLabel" Text="Обича филми и храна! Винаги търси нови преживявания." FontSize="13" TextColor="#374151" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="22" CornerRadius="16" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Редакция на профила" FontSize="16" FontAttributes="Bold" TextColor="#111827" />
                    <Entry x:Name="DisplayNameEntry" Placeholder="Показвано име" BackgroundColor="#F9FAFB" />
                    <Editor x:Name="BioEditor" Placeholder="Кратко описание" AutoSize="TextChanges" HeightRequest="88" BackgroundColor="#F9FAFB" />
                    <Label Text="Профилна снимка" FontAttributes="Bold" TextColor="#111827" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry x:Name="ProfileImageUrlEntry"
                               Placeholder="https://.../avatar.jpg"
                               BackgroundColor="#F9FAFB"
                               Keyboard="Url"
                               TextChanged="OnProfileImageUrlChanged" />
                        <Button Grid.Column="1"
                                Text="Преглед"
                                BackgroundColor="#F3E8FF"
                                TextColor="#7C3AED"
                                CornerRadius="10"
                                Padding="14,0"
                                Clicked="OnPreviewImageClicked" />
                    </Grid>
                    <Label Text="Постави директен http/https линк към изображение. Ако няма линк, SwipeMate показва аватар с инициали."
                           FontSize="12"
                           TextColor="#6B7280" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label x:Name="ProfileImageStatusLabel"
                               Text=""
                               FontSize="12"
                               TextColor="#6B7280"
                               VerticalTextAlignment="Center"
                               IsVisible="False" />
                        <Button Grid.Column="1"
                                Text="Премахни"
                                BackgroundColor="#F9FAFB"
                                TextColor="#6B7280"
                                BorderColor="#E5E7EB"
                                BorderWidth="1"
                                CornerRadius="10"
                                Padding="14,0"
                                Clicked="OnClearProfileImageClicked" />
                    </Grid>
                    <Button Text="Запази профила" BackgroundColor="#C026D3" TextColor="White" CornerRadius="10" HeightRequest="48" Clicked="OnSaveProfileClicked" />
                </VerticalStackLayout>
            </Frame>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Frame Padding="18" CornerRadius="14" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="Трофей" TextColor="#EAB308" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label x:Name="MatchesCountLabel" Text="0" FontSize="26" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="Съвпадения" FontSize="12" TextColor="#6B7280" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="1" Padding="18" CornerRadius="14" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="Сесии" TextColor="#3B82F6" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label x:Name="SessionsCountLabel" Text="0" FontSize="26" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="Сесии" FontSize="12" TextColor="#6B7280" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="2" Padding="18" CornerRadius="14" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="Действия" TextColor="#A855F7" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label x:Name="RatingsCountLabel" Text="0" FontSize="26" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="Действия" FontSize="12" TextColor="#6B7280" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <Frame Padding="22" CornerRadius="16" BackgroundColor="White" BorderColor="#E5E7EB" HasShadow="False">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Значки и постижения" FontSize="16" FontAttributes="Bold" TextColor="#111827" />
                    <Border Padding="16" Stroke="#FACC15" BackgroundColor="#FEF9C3" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Ниво Рецензент 1" FontAttributes="Bold" TextColor="#111827" />
                            <Label Text="Използва приложението и създава решения." FontSize="12" TextColor="#6B7280" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Padding="16" Stroke="#FACC15" BackgroundColor="#FEF3C7" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Активен потребител" FontAttributes="Bold" TextColor="#111827" />
                            <Label Text="Създава сесии и гласува активно." FontSize="12" TextColor="#6B7280" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Frame>

            <Frame Padding="22" CornerRadius="16" BackgroundColor="#FDF2F8" BorderColor="#E5E7EB" HasShadow="False">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Напредък към следващо постижение" FontSize="16" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="*,Auto"><Label Text="Създател на сесии" FontSize="12" /><Label x:Name="SessionProgressLabel" Grid.Column="1" FontSize="12" TextColor="#6B7280" /></Grid>
                    <ProgressBar x:Name="SessionProgress" ProgressColor="#EC4899" BackgroundColor="#E5E7EB" />
                    <Grid ColumnDefinitions="*,Auto"><Label Text="Супер потребител" FontSize="12" /><Label x:Name="RatingProgressLabel" Grid.Column="1" FontSize="12" TextColor="#6B7280" /></Grid>
                    <ProgressBar x:Name="RatingProgress" ProgressColor="#A855F7" BackgroundColor="#E5E7EB" />
                    <Grid ColumnDefinitions="*,Auto"><Label Text="Майстор на съвпаденията" FontSize="12" /><Label x:Name="MatchProgressLabel" Grid.Column="1" FontSize="12" TextColor="#6B7280" /></Grid>
                    <ProgressBar x:Name="MatchProgress" ProgressColor="#EC4899" BackgroundColor="#E5E7EB" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
